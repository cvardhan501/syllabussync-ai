# SyllabusSync AI Backend Configuration
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://syllabussync-ai.vercel.app"]
MAX_UPLOAD_SIZE_MB=4.5

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./syllabus_sync.db

# Production Deployment (Supabase PostgreSQL Transaction Pooler):
# Use the Supavisor / PgBouncer Transaction Pooler on port 6543 (NOT direct port 5432)
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@[pooler-host]:6543/postgres?sslmode=require
# Example:
# DATABASE_URL=postgresql://postgres.qdlnupgdtgmhvkknjmlv:YOUR_PASSWORD_HERE@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# Strands Agents SDK Configuration (Phase 2)
# ==============================================================================
# Provider options: "bedrock" (default for Strands), "openai", "anthropic", "ollama"
STRANDS_PROVIDER=bedrock

# Model identifier for Strands
# Bedrock example: amazon.nova-lite-v1:0, bedrock/us.anthropic.claude-3-5-sonnet-20241022-v2:0
# OpenAI example: openai/gpt-4o-mini
# Anthropic example: anthropic/claude-3-5-sonnet-20241022
STRANDS_MODEL=amazon.nova-lite-v1:0

# AWS Credentials (Required if STRANDS_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-2
# AWS_SESSION_TOKEN=your_aws_session_token_here (optional)

# OpenAI Credentials (Required if STRANDS_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Credentials (Required if STRANDS_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Development Fallback Flag:
# If set to true, allows deterministic local fallback when credentials are not configured,
# explicitly labeled as 'is_fallback: true' with full UI transparency.
ALLOW_DEV_FALLBACK_ANALYSIS=true

# ==============================================================================
# YouTube Data API v3 Configuration (Phase 3)
# ==============================================================================
# Obtain an API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project, enable "YouTube Data API v3"
# 3. Create Credentials -> API key (restrict key to YouTube Data API v3 and IP/HTTP referrers)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# YouTube request limits and cache controls
YOUTUBE_MAX_SEARCH_RESULTS=5
YOUTUBE_CACHE_TTL_HOURS=48

# Development fallback flag:
# If set to true, allows deterministic local discovery when YOUTUBE_API_KEY is not set,
# clearly labeled as 'is_fallback: true' with honest UI indicators.
ALLOW_DEV_FALLBACK_YOUTUBE=true

# ==============================================================================
# Supabase Authentication & Security Configuration (Production Readiness)
# ==============================================================================
# In production (APP_ENV=production), valid Supabase JWT Bearer tokens are mandatory.
# Simulated X-User-Id headers are strictly rejected in production.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# SUPABASE_PROJECT_URL=https://your-project.supabase.co
# ADMIN_API_KEY=your_secure_admin_key_for_production_diagnostics

